config_version=5

[application]
config/name="DQ9-Decomp"
run/main_scene="res://scenes/main.tscn"
run/max_fps=60

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
ds_a={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":90),Object(InputEventJoypadButton,"button_index":1)]}
ds_b={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":88),Object(InputEventJoypadButton,"button_index":0)]}
ds_x={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventJoypadButton,"button_index":3)]}
ds_y={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventJoypadButton,"button_index":2)]}
ds_start={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194309),Object(InputEventJoypadButton,"button_index":6)]}
ds_select={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194308),Object(InputEventJoypadButton,"button_index":4)]}
ds_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194320),Object(InputEventJoypadButton,"button_index":11),Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]}
ds_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194322),Object(InputEventJoypadButton,"button_index":12),Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]}
ds_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194319),Object(InputEventJoypadButton,"button_index":13),Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
ds_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194321),Object(InputEventJoypadButton,"button_index":14),Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]}
ds_l={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventJoypadButton,"button_index":9)]}
ds_r={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81),Object(InputEventJoypadButton,"button_index":10)]}
