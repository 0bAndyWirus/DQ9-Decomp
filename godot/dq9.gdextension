[configuration]
entry_symbol = "dq9_godot_init"
compatibility_minimum = "4.2"

[libraries]
linux.debug.x86_64 = "res://bin/libdq9_godot.so"
linux.release.x86_64 = "res://bin/libdq9_godot.so"
windows.debug.x86_64 = "res://bin/dq9_godot.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://bin/dq9_godot.windows.template_release.x86_64.dll"

[dependencies]
windows.debug.x86_64 = { "res://bin/dsr_session.dll": "" }
windows.release.x86_64 = { "res://bin/dsr_session.dll": "" }
